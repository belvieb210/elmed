{
  "name": "matemedical-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API MateMedical — ERP médical B2B",
  "main": "dist/serveur.js",
  "scripts": {
    "dev": "tsx watch src/serveur.ts",
